{
  "entities": {
    "SurveyResponse": {
      "title": "SurveyResponse",
      "description": "A single survey response from a student regarding study habits and phone addiction.",
      "type": "object",
      "properties": {
        "fullName": {
          "type": "string",
          "description": "Full name of the student"
        },
        "birthDate": {
          "type": "string",
          "description": "Birth date in YYYY-MM-DD format"
        },
        "q1_gender": {
          "type": "string",
          "enum": ["Nam", "Nữ"]
        },
        "q2_grade": {
          "type": "string",
          "enum": ["6", "7", "8", "9", "10", "11", "12"]
        },
        "q3_location": {
          "type": "string",
          "enum": ["Thành phố", "Nông thôn"]
        },
        "q4_livingWith": {
          "type": "string",
          "enum": ["Bố mẹ", "Ông bà", "Người thân khác"]
        },
        "q5_parentsHome": {
          "type": "string",
          "enum": ["Thường xuyên", "Thỉnh thoảng", "Ít khi"]
        },
        "q6_hasOwnPhone": {
          "type": "string",
          "enum": ["Có", "Không"]
        },
        "q7_phoneHours": {
          "type": "string",
          "enum": ["Dưới 1 giờ", "1–3 giờ", "3–5 giờ", "Trên 5 giờ"]
        },
        "q8_phoneUsage": {
          "type": "array",
          "description": "List of activities"
        },
        "q9_studyWithPhone": {
          "type": "string",
          "enum": ["Thường xuyên", "Thỉnh thoảng", "Hiếm khi"]
        },
        "q10_distractor": {
          "type": "string",
          "enum": ["Điện thoại", "Game", "Mạng xã hội", "Tiếng ồn", "Khác"]
        },
        "q11_experienced": {
          "type": "array",
          "description": "List of issues experienced"
        },
        "q12_selfStudyHours": {
          "type": "string",
          "enum": ["Dưới 1 giờ", "1–2 giờ", "2–4 giờ", "Trên 4 giờ"]
        },
        "q13_easilyDistracted": {
          "type": "string",
          "enum": ["Có", "Không"]
        },
        "q14_wantsFocusDevice": {
          "type": "string",
          "enum": ["Có", "Không"]
        },
        "q15_deviceOpinion": {
          "type": "string",
          "enum": ["Rất cần thiết", "Cần thiết", "Bình thường", "Không cần thiết"]
        },
        "q16_phoneImpact": {
          "type": "string",
          "description": "Student's thoughts on phone impact"
        },
        "q17_desiredFeatures": {
          "type": "string",
          "description": "Any desired features for the study device"
        },
        "ipAddress": {
          "type": "string",
          "description": "User's IP Address for entry locking"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "fullName",
        "birthDate",
        "q1_gender",
        "q2_grade",
        "q3_location",
        "q4_livingWith",
        "q5_parentsHome",
        "q6_hasOwnPhone",
        "q7_phoneHours",
        "q9_studyWithPhone",
        "q10_distractor",
        "q12_selfStudyHours",
        "q13_easilyDistracted",
        "q14_wantsFocusDevice",
        "q15_deviceOpinion",
        "ipAddress",
        "createdAt"
      ]
    }
  },
  "firestore": {
    "/survey_responses/{responseId}": {
      "schema": "SurveyResponse",
      "description": "Collection storing student survey responses."
    }
  }
}
